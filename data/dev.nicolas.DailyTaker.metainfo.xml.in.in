<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@app-id@.desktop</id>
  <name>Daily Taker</name>
  <summary>Gravador de voz pessoal com transcrição de reuniões</summary>
  <project_license>GPL-2.0+</project_license>
  <metadata_license>CC0-1.0</metadata_license>
  <description>
    <p>
      O Daily Taker grava sua voz pelo microfone junto com o som do computador,
      como o áudio de uma reunião online, e guarda tudo em um único arquivo.
    </p>
    <p>
      Quando você pede, o áudio é enviado ao OpenRouter para gerar a transcrição,
      com a fala separada por locutores. A transcrição pode ser lida junto com o
      áudio, pesquisada, copiada e exportada em Markdown ou texto.
    </p>
    <p>
      O Daily Taker é baseado no Vocalis, que por sua vez é baseado no
      GNOME Sound Recorder.
    </p>
  </description>
  <content_rating type="oars-1.0" />
  <releases>
    <release version="0.1.0" date="2026-10-22" />
  </releases>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
  <developer id="dev.nicolas">
    <name>Nicolas Melo</name>
  </developer>
</component>
