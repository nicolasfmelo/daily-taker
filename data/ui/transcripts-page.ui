<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="Gjs_TranscriptsPage" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="hexpand">True</property>
    <property name="vexpand">True</property>
    <child>
      <object class="AdwClamp">
        <property name="maximum_size">650</property>
        <property name="child">
          <object class="GtkBox">
            <property name="spacing">6</property>
            <property name="margin_start">8</property>
            <property name="margin_end">8</property>
            <property name="margin_top">12</property>
            <child>
              <object class="GtkSearchEntry" id="searchEntry">
                <property name="hexpand">True</property>
                <property name="search_delay">200</property>
                <property name="placeholder_text">Buscar nas transcrições</property>
              </object>
            </child>
            <child>
              <object class="GtkMenuButton" id="fromButton">
                <property name="label">De</property>
                <property name="tooltip_text">Mostrar a partir deste dia</property>
                <property name="popover">
                  <object class="GtkPopover" id="fromPopover">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkCalendar" id="fromCalendar"/>
                        </child>
                        <child>
                          <object class="GtkButton" id="fromClearButton">
                            <property name="label">Limpar</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkMenuButton" id="toButton">
                <property name="label">Até</property>
                <property name="tooltip_text">Mostrar até este dia</property>
                <property name="popover">
                  <object class="GtkPopover" id="toPopover">
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkCalendar" id="toCalendar"/>
                        </child>
                        <child>
                          <object class="GtkButton" id="toClearButton">
                            <property name="label">Limpar</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkStack" id="contentStack">
        <property name="hexpand">True</property>
        <property name="vexpand">True</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">list</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="hexpand">True</property>
                <property name="vexpand">True</property>
                <property name="hscrollbar_policy">never</property>
                <property name="child">
                  <object class="AdwClamp">
                    <property name="maximum_size">650</property>
                    <property name="child">
                      <object class="GtkListBox" id="listBox">
                        <property name="valign">start</property>
                        <property name="margin_start">8</property>
                        <property name="margin_end">8</property>
                        <property name="margin_top">12</property>
                        <property name="margin_bottom">12</property>
                        <property name="selection_mode">none</property>
                        <property name="activate_on_single_click">True</property>
                        <style>
                          <class name="boxed-list"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">empty</property>
            <property name="child">
              <object class="AdwStatusPage" id="emptyStatus">
                <property name="icon_name">edit-find-symbolic</property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
