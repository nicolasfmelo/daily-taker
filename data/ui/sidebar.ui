<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="Gjs_Sidebar" parent="GtkBox">
    <property name="orientation">vertical</property>
    <property name="width_request">300</property>
    <property name="vexpand">True</property>
    <style>
      <class name="sidebar"/>
      <class name="bg-window"/>
    </style>
    <!-- Cabeçalho: título e Exportar áudio da gravação selecionada. -->
    <child>
      <object class="GtkBox">
        <property name="spacing">12</property>
        <style>
          <class name="sidebar-header"/>
        </style>
        <child>
          <object class="GtkLabel">
            <property name="label">Gravações</property>
            <property name="xalign">0</property>
            <property name="hexpand">True</property>
            <property name="ellipsize">end</property>
            <style>
              <class name="sidebar-title"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="exportButton">
            <property name="icon_name">export-audio-symbolic</property>
            <property name="tooltip_text">Exportar áudio da gravação selecionada</property>
            <property name="valign">center</property>
            <property name="sensitive">False</property>
            <accessibility>
              <property name="label">Exportar áudio</property>
            </accessibility>
            <style>
              <class name="detail-toolbar-button"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSearchEntry" id="searchEntry">
        <property name="placeholder_text">Buscar gravação</property>
        <property name="search_delay">150</property>
        <style>
          <class name="sidebar-search"/>
        </style>
      </object>
    </child>
    <!-- Lista (rola) ou o aviso de lista vazia. -->
    <child>
      <object class="GtkStack" id="listStack">
        <property name="vexpand">True</property>
        <child>
          <object class="GtkStackPage">
            <property name="name">list</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar_policy">never</property>
                <property name="vexpand">True</property>
                <property name="child">
                  <object class="GtkListBox" id="list">
                    <property name="selection_mode">single</property>
                    <property name="activate_on_single_click">True</property>
                    <property name="valign">start</property>
                    <accessibility>
                      <property name="label">Gravações</property>
                    </accessibility>
                    <style>
                      <class name="sidebar-list"/>
                    </style>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">empty</property>
            <property name="child">
              <object class="GtkLabel" id="emptyLabel">
                <property name="wrap">True</property>
                <property name="justify">center</property>
                <property name="valign">center</property>
                <property name="halign">center</property>
                <property name="margin_start">24</property>
                <property name="margin_end">24</property>
                <style>
                  <class name="sidebar-empty"/>
                </style>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
    <!-- Rodapé fixo (informativo). -->
    <child>
      <object class="GtkBox">
        <property name="spacing">10</property>
        <style>
          <class name="sidebar-footer"/>
        </style>
        <child>
          <object class="GtkImage">
            <property name="icon_name">media-floppy-symbolic</property>
            <property name="pixel_size">18</property>
            <property name="accessible_role">presentation</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label">Salvo neste dispositivo</property>
            <property name="xalign">0</property>
            <property name="ellipsize">end</property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
