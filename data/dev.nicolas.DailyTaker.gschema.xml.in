<schemalist>
  <schema id="@app-id@" path="/dev/nicolas/DailyTaker/">
    <key name="window-size" type="ai">
      <default>[780, 480]</default>
      <summary>Tamanho da janela</summary>
      <description>Tamanho da janela (largura e altura).</description>
    </key>
    <key name="window-position" type="ai">
      <default>[]</default>
      <summary>Posição da janela</summary>
      <description>Posição da janela (x e y).</description>
    </key>
    <key name="language" type="s">
      <choices>
        <choice value="pt"/>
        <choice value="auto"/>
      </choices>
      <default>'pt'</default>
      <summary>Idioma da transcrição</summary>
      <description>Idioma enviado ao serviço de transcrição: "pt" para português ou "auto" para detecção automática.</description>
    </key>
    <key name="playback-rate" type="d">
      <range min="0.75" max="2"/>
      <default>1.0</default>
      <summary>Velocidade de reprodução</summary>
      <description>Velocidade do player: 0,75, 1, 1,25, 1,5 ou 2.</description>
    </key>
    <key name="playback-volume" type="d">
      <range min="0" max="1"/>
      <default>1.0</default>
      <summary>Volume de reprodução</summary>
      <description>Volume do player, de 0 a 1.</description>
    </key>
    <key name="follow-audio" type="b">
      <default>true</default>
      <summary>Acompanhar áudio</summary>
      <description>Rola a transcrição para o trecho que está tocando.</description>
    </key>
  </schema>
</schemalist>



