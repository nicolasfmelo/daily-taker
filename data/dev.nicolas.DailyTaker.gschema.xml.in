<schemalist>
  <schema id="@app-id@" path="/dev/nicolas/DailyTaker/" gettext-domain="@gettext-package@">
    <key name="window-size" type="ai">
      <default>[780, 480]</default>
      <summary>Window size</summary>
      <description>Window size (width and height).</description>
    </key>
    <key name="window-position" type="ai">
      <default>[]</default>
      <summary>Window position</summary>
      <description>Window position (x and y).</description>
    </key>
    <key name="language" type="s">
      <choices>
        <choice value="pt"/>
        <choice value="auto"/>
      </choices>
      <default>'pt'</default>
      <summary>Transcription language</summary>
      <description>Language sent to the transcription service: "pt" for Portuguese or "auto" for automatic detection.</description>
    </key>
  </schema>
</schemalist>



