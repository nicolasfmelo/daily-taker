<schemalist>
  <schema id="@app-id@" path="/dev/nicolas/DailyTaker/">
    <key name="window-size" type="ai">
      <default>[780, 480]</default>
      <summary>Tamanho da janela</summary>
      <description>Tamanho da janela (largura e altura).</description>
    </key>
    <key name="window-position" type="ai">
      <default>[]</default>
      <summary>Posição da janela</summary>
      <description>Posição da janela (x e y).</description>
    </key>
    <key name="language" type="s">
      <choices>
        <choice value="pt"/>
        <choice value="auto"/>
      </choices>
      <default>'pt'</default>
      <summary>Idioma da transcrição</summary>
      <description>Idioma enviado ao serviço de transcrição: "pt" para português ou "auto" para detecção automática.</description>
    </key>
  </schema>
</schemalist>



